{
  "name": "dsh-ccd",
  "version": "0.1.1",
  "description": "Show the user short first-person working notes instead of the raw chain of thought, while the model keeps seeing the full reasoning",
  "license": "MIT",
  "author": "YG",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "reasoning",
    "chain-of-thought",
    "ccd"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "local.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "test/*.mjs"
  ],
  "scripts": {
    "test": "node test/notes.mjs && node test/pipeline.mjs && node test/segment.mjs && node test/store.mjs && node test/local.mjs && node test/settings.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "homepage": "https://github.com/mmyddd/dsh-ccd#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmyddd/dsh-ccd.git"
  },
  "bugs": {
    "url": "https://github.com/mmyddd/dsh-ccd/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  }
}
